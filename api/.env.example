# HTTP listen address. Use :8080 to listen on all interfaces.
HTTP_ADDR=:8080

# Simulation update interval. Go duration syntax is supported.
TICK_INTERVAL=200ms

# Comma-separated browser origins allowed by CORS and WebSocket handshakes.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional JSON mission file. Empty uses the built-in Shenzhen example.
MISSION_FILE=

# Simulated collision thresholds in meters (visualization demo only, not flight safety).
COLLISION_WARN_M=100
COLLISION_CRITICAL_M=50
COLLISION_CLEAR_M=120
COLLISION_HORIZON_S=15
COLLISION_EVADE_ALT_M=15
